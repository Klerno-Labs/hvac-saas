# Template only. Store actual values outside the release at /etc/fieldclose/app.env.
# Owner root, group fieldclose, permissions 0640. Never commit or log real values.
# Staging uses a separate database, synthetic accounts and sandbox Stripe keys.
DEPLOYMENT_ENV=preview
SCHEDULED_TASKS_ENABLED=false
AUTH_TRUST_HOST=true
AUTH_SECRET=
AUTH_URL=
NEXTAUTH_URL=
APP_URL=
NEXT_PUBLIC_APP_URL=
DATABASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Copy the remaining REQUIRED/configured variables from the approved environment
# inventory at deployment time. This template is not a complete credential set.
