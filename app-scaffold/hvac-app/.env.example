DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/hvac"
AUTH_SECRET="replace-me-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
STRIPE_SECRET_KEY=""
# Platform subscription webhook signing secret.
STRIPE_WEBHOOK_SECRET=""
# Separate connected-account customer-payment webhook signing secret.
STRIPE_CONNECT_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""
APP_URL="http://localhost:3000"
NEXT_PUBLIC_SERVICE_TRADE="hvac"
# Public support destination approved for this deployment. Not a secret.
# Unset or invalid values fall back to support@fieldclose.app; rebuild after changes.
NEXT_PUBLIC_SUPPORT_EMAIL="pegriollc@gmail.com"

# Optional public conversion events. Requires an eligible Vercel Analytics plan.
# Leave disabled until analytics is activated and receipt is verified.
NEXT_PUBLIC_ENABLE_FUNNEL_EVENTS="false"
# Optional error reporting. Both destinations are needed for server and browser coverage.
# Use the approved FieldClose Sentry project; leave blank until it is available.
# NEXT_PUBLIC_SENTRY_DSN is bundled into the browser at build time. Redeploy after changes.
# Never put a Sentry auth token in a NEXT_PUBLIC_ variable. See docs/monitoring-and-support.md.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
OPENAI_API_KEY=""
# Vercel automatically sends this value as an Authorization bearer token.
CRON_SECRET=""
# Set false while staging a production candidate or preparing database migrations.
# Unset/true enables execution; environment changes require a new deployment.
SCHEDULED_TASKS_ENABLED=""
# Legacy external schedulers may continue using this token. Prefer the same value during migration.
COLLECTIONS_CRON_SECRET=""
RESEND_API_KEY=""
EMAIL_FROM="HVAC SaaS <noreply@resend.dev>"
STRIPE_STARTER_PRICE_ID=""
STRIPE_PRO_PRICE_ID=""
# Optional FieldClose-specific portal config (bpc_...). Match the Stripe account/mode.
# Unset uses that account's default; use an explicit config when other apps share Stripe.
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=""

# Twilio outbound SMS credentials and sending number; auth token also verifies inbound signatures.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Robert satellite control plane (https://app.pegrio.com)
ROBERT_API_URL="https://app.pegrio.com"
ROBERT_APP_SLUG="fieldclose"
ROBERT_APP_SECRET=""

# Cloudflare R2: private bucket, scoped Object Read & Write credentials.
# Leave r2.dev and custom-domain public access disabled. App routes authorize reads.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Legacy public photo URLs already stored in the database remain readable.
# R2_PUBLIC_BASE_URL is no longer used or required for new uploads.
